node_modules/
dist/
build/
.next/
out/
coverage/
.nyc_output/

# Every env file is ignored by default, including variants not yet invented
# (.env.staging, .env.production, server/.env). The template is the one
# exception, and the negation must stay last so it wins.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Private key material and credential dumps, in any directory.
*.pem
*.key
*.p12
*.pfx
id_rsa*
credentials.json

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

server/uploads/
!server/uploads/.gitkeep

.DS_Store
Thumbs.db
desktop.ini

.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

*.tsbuildinfo
.eslintcache

cypress/videos/
cypress/screenshots/
cypress/downloads/

.turbo/
.vercel/
settings.local.json

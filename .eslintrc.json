{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint", "import"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/recommended",
    "plugin:import/typescript",
    "prettier"
  ],
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".next",
    "out",
    "coverage",
    "*.config.js",
    "*.config.mjs"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "@typescript-eslint/consistent-type-imports": [
      "error",
      { "prefer": "type-imports", "fixStyle": "inline-type-imports" }
    ],
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-eval": "error",
    "no-implied-eval": "error",
    "import/order": [
      "error",
      {
        "groups": ["builtin", "external", "internal", "parent", "sibling", "index"],
        "newlines-between": "always",
        "alphabetize": { "order": "asc", "caseInsensitive": true }
      }
    ],
    "import/no-unresolved": "off",
    "import/no-named-as-default": "off",
    "import/no-named-as-default-member": "off"
  },
  "overrides": [
    {
      "files": ["shared/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["mongoose", "express", "react", "next", "@server/*", "@client/*"],
                "message": "The shared workspace must stay framework-agnostic."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["server/src/services/**/*.ts"],
      "rules": {
        "no-restricted-imports": "off",
        "@typescript-eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/models/*", "@/models/*"],
                "message": "Services must not touch Mongoose models at runtime. Use a repository. (Type-only imports of the document shape are allowed.)",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["server/src/controllers/**/*.ts"],
      "rules": {
        "no-restricted-imports": "off",
        "@typescript-eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/models/*", "@/models/*"],
                "message": "Controllers must go through services. (Type-only imports are allowed.)",
                "allowTypeImports": true
              },
              {
                "group": ["**/repositories/*", "@/repositories/*"],
                "message": "Controllers must go through services. (Type-only imports are allowed.)",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "server/src/database/seeders/**/*.ts"],
      "rules": {
        "no-console": "off",
        "@typescript-eslint/no-explicit-any": "off",
        "no-restricted-imports": "off"
      }
    }
  ]
}

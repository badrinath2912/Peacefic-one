# LOCAL ONLY — gitignored. Never commit this file.
# Secrets here are real; rotate them if they are ever exposed.

NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
LOG_LEVEL=debug
TRUST_PROXY=false

# MongoDB Atlas. The database name is supplied separately via MONGODB_DB_NAME,
# so the URI deliberately carries no path segment.
MONGODB_URI=mongodb+srv://badrimadarapu2912_db_user:Peacefic1234@cluster0.pweesrr.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=peacefic_one

# Redis is optional locally; caching, queues and cross-instance sockets degrade
# gracefully without it.
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

JWT_ACCESS_SECRET=Eetr1wIinyka1bOxnbnWDClOBk9UYyGRpsHCa94w0AIxMCDKkrrJ70fex8TyAZI3
JWT_REFRESH_SECRET=eR7qiRlZXnCv3RjJPOnX0G49E6MLTt7rO-oCJ58OGJtk8ugoG-DzVzmj3xzRLICJ
JWT_INVITE_SECRET=_6Oc-CkqumjWNUXiBHoMxu2pzsDVwYgiSH0q8KkrOyHKkt0pux5JHxILBt5zYUH9
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_DAYS=7
JWT_REFRESH_REMEMBER_DAYS=30
JWT_ISSUER=peacefic-one
JWT_AUDIENCE=peacefic-one-client
BCRYPT_ROUNDS=12
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Fine for local development: localhost:3000 and localhost:5000 are same-site.
# Change to "none" (with COOKIE_SECURE=true) for a Vercel + Render deployment.
COOKIE_SAME_SITE=strict
SESSION_MAX_DEVICES=5

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=

STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads

# "console" logs the message instead of sending it — no real mail leaves this machine.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@peacefic.one
EMAIL_FROM_NAME=Peacefic One

MEETING_PROVIDER=jitsi
JITSI_DOMAIN=meet.jit.si

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
ENABLE_API_DOCS=true

ATTENDANCE_LOCK_AFTER_HOURS=48
DEFAULT_ATTENDANCE_THRESHOLD=75

AI_PROVIDER=
AI_API_KEY=
AI_MONTHLY_TOKEN_BUDGET=

NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=Peacefic One

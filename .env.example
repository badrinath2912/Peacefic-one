# ---------------------------------------------------------------------------
# Peacefic One — environment configuration
# Copy to .env and fill in. The server refuses to boot if anything required
# here is missing or malformed (server/src/config/env.ts).
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
LOG_LEVEL=debug
TRUST_PROXY=false

# Database
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
# Leave the path empty — the database name comes from MONGODB_DB_NAME below.
# Transactions require a replica set; Atlas provides one, a standalone local
# mongod does not (see docker/docker-compose.yml for a local replica set).
MONGODB_URI=mongodb:+srv://badrimadarapu2912_db_user:Peacefic1234//localhost:27017
MONGODB_DB_NAME=peacefic_one

# Redis (caching, rate limits, queues, socket adapter)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-with-a-random-string-32-characters-min
JWT_REFRESH_SECRET=replace-me-with-a-different-random-string-32-chars-min
JWT_INVITE_SECRET=replace-me-with-a-third-random-string-32-characters-min
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_DAYS=7
JWT_REFRESH_REMEMBER_DAYS=30
JWT_ISSUER=peacefic-one
JWT_AUDIENCE=peacefic-one-client
BCRYPT_ROUNDS=12
COOKIE_DOMAIN=
COOKIE_SECURE=false
# strict | lax | none
# "strict" is correct when the client and API share a registrable domain
# (localhost counts — the port is irrelevant to same-site).
# A SPLIT DEPLOYMENT IS CROSS-SITE: front end on Vercel with the API on Render
# needs "none", or the browser silently drops the refresh cookie and every
# session ends after 15 minutes. "none" also requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=strict
SESSION_MAX_DEVICES=5

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=

# Storage — local | s3 | cloudinary
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — console | smtp | sendgrid
# "console" writes to the log instead of sending; never allowed in production.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@peacefic.one
EMAIL_FROM_NAME=Peacefic One
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=

# Live classes
MEETING_PROVIDER=jitsi
JITSI_DOMAIN=meet.jit.si

# Security
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
ENABLE_API_DOCS=true

# Domain rules
ATTENDANCE_LOCK_AFTER_HOURS=48
DEFAULT_ATTENDANCE_THRESHOLD=75

# AI (not called in this scope; the seam exists)
AI_PROVIDER=
AI_API_KEY=
AI_MONTHLY_TOKEN_BUDGET=

# ---------------------------------------------------------------------------
# Client (Next.js). These are exposed to the browser — never put a secret here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=Peacefic One
